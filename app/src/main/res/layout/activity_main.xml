<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.ext.audiovisualizer.view.AudioVisualizerView
        android:id="@+id/audioVisualizer"
        android:layout_width="match_parent"
        android:layout_height="220dp"

        app:av_style="circle"
        android:layout_gravity="center"

        app:av_enableGradient="true"
        app:av_gradientStartColor="#00E5FF"
        app:av_gradientEndColor="#FF00FF"

        app:av_enableGlow="true"
        app:av_glowRadius="24dp" />



</LinearLayout>